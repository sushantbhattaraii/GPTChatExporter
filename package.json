{
  "name": "chatgpt-conversation-exporter",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run build && npm test && npm run test:render",
    "test:render": "node tests/render.mjs",
    "format": "prettier --write \"src/**/*.js\" \"tests/*.mjs\" \"scripts/*.mjs\" \"public/*.{html,css,json}\""
  },
  "dependencies": {
    "docx": "9.15.2",
    "mathjax-full": "3.2.2",
    "mathml2omml": "0.5.0",
    "mermaid": "11.12.2",
    "pdfmake": "0.2.20"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "playwright": "1.56.1",
    "prettier": "3.6.2"
  }
}
